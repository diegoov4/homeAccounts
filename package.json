{
  "name": "gastos-casa",
  "version": "1.0.0",
  "description": "Gestor de gastos familiares (Cloudflare Workers + D1)",
  "scripts": {
    "dev": "wrangler dev --local-upstream localhost:8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create gastos-casa",
    "db:migrate:local": "wrangler d1 migrations apply gastos-casa --local",
    "db:migrate": "wrangler d1 migrations apply gastos-casa --remote",
    "secrets": "wrangler secret put GOOGLE_CLIENT_ID && wrangler secret put GOOGLE_CLIENT_SECRET && wrangler secret put ALLOWED_EMAILS",
    "test": "node tests/e2e.mjs",
    "test:smoke": "node tests/smoke.mjs",
    "release": "npm test && wrangler d1 migrations apply gastos-casa --remote && wrangler deploy && npm run test:smoke",
    "test:bank": "python3 -I tests/test_bank_import.py",
    "bank": "python3 -I scripts/bank_import.py"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diegoov4/homeAccounts.git"
  },
  "bugs": {
    "url": "https://github.com/diegoov4/homeAccounts/issues"
  },
  "homepage": "https://github.com/diegoov4/homeAccounts#readme",
  "devDependencies": {
    "wrangler": "^4.162.0"
  },
  "private": true
}
